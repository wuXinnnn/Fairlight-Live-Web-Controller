{
  "name": "@flwc/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dump-tree": "tsx src/tools/dump-tree.ts",
    "verify-ember": "tsx src/tools/verify-ember.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@flwc/shared": "workspace:*",
    "emberplus-connection": "0.3.1",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@flwc/test-utils": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

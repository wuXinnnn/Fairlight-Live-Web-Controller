{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the launcher window is allowed to ask the Rust side for.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide"
  ]
}

# Copy this file to .env and edit it. The start scripts read .env; it is not committed.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS, Linux)
#
# A variable already set in the shell still wins over this file, so `set PORT=3100 && start.cmd`
# overrides it for one run. Values are literal: no quotes needed, and no variable expansion.
#
# Docker does not read this file. Use the `environment:` block in docker-compose.yml instead.

# The address the web server binds. The start scripts use 0.0.0.0 when this is not set, so a
# tablet on the same network can reach it. Set 127.0.0.1 to keep it on this machine only.
#HOST=0.0.0.0

# The port the web server binds.
#PORT=3000

# Where Fairlight Live is. These two are seed values: they are written to config.json on the very
# first start, when there is no file yet, and ignored from then on. Once it exists, the
# CONNECTION panel in the UI is what changes the address.
#EMBER_HOST=192.168.1.10
#EMBER_PORT=9000

# Where config.json is kept. Relative paths are resolved against this directory.
#FLWC_DATA_DIR=data

# Where the web build is served from.
#FLWC_WEB_ROOT=apps/web/dist

# Exit when stdin closes. For process supervisors and the desktop launcher; leave it unset when
# starting from a console, or Ctrl+C is all you have.
#FLWC_EXIT_ON_STDIN_CLOSE=1

# How often, in milliseconds, a short-lived probe connection asks Fairlight Live for the list of
# channels it may have added without telling us. Each probe is a fresh connection the desk has to
# admit, so keep this in minutes; changes the desk does announce are picked up without waiting.
# 0 turns the probe off altogether.
#FLWC_EMBER_PROBE_INTERVAL_MS=60000

# How long, in milliseconds, to wait for the desk to describe one channel while the tree is read.
# Raise it if channels are missing from the mixer page after connecting to a busy desk.
#FLWC_EMBER_STRIP_TIMEOUT_MS=2000
